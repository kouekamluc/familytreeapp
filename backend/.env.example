DEBUG=True
SECRET_KEY=replace-with-a-long-random-private-value
DB_ENGINE=django.db.backends.postgresql
DB_NAME=familytree
DB_USER=postgres
DB_PASSWORD=replace-locally
DB_HOST=127.0.0.1
DB_PORT=5432
# Required when DEBUG=False. Use the actual public domain and HTTPS origins.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8085,http://127.0.0.1:8085
CSRF_TRUSTED_ORIGINS=http://localhost:8085,http://127.0.0.1:8085
# Enable only if a trusted reverse proxy strips and sets this header.
TRUST_PROXY_SSL_HEADER=False
# Production uploads and backups should use persistent directories outside the checkout.
# MEDIA_ROOT=/srv/familytree/media
# BACKUP_ROOT=/srv/familytree/backups

# Account verification and recovery require a working sender before public release.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-locally
EMAIL_HOST_PASSWORD=replace-locally
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Kkevo Family <accounts@example.com>

# Populate after selecting real release resources; check_release never sends mail or publishes.
PUBLIC_BASE_URL=
SUPPORT_EMAIL=
PRIVACY_POLICY_URL=
ACCOUNT_DELETION_POLICY_VERSION=
